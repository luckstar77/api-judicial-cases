# 伺服器
PORT=3010
NODE_ENV=production
# 逗號分隔；未設定時預設允許 https://rental.imallenlai.com 與本機開發網址
CORS_ORIGINS=https://rental.imallenlai.com,http://localhost:5173,http://localhost:3011

# 資料庫（未設定時預設 127.0.0.1:3306 root / 空密碼 / rental）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rental

# 驗證
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Firebase（只用 projectId 驗證手機簡訊 ID token）
FIREBASE_PROJECT_ID=

# S3（案例圖片）
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=images-rental

# 限流（每 IP 每分鐘）
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
